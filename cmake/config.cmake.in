# Generated by CMake @CMAKE_VERSION@ for @PROJECT_NAME@
@PACKAGE_INIT@

# valid components that can be searched for
set(_@PROJECT_NAME@_supported_components @xxx_project_components@)
message(STATUS "Valid components for @PROJECT_NAME@: ${_@PROJECT_NAME@_supported_components}")
message(STATUS "Requested components for @PROJECT_NAME@: ${@PROJECT_NAME@_FIND_COMPONENTS}")

# iterate through components attempting to be found
foreach(component ${@PROJECT_NAME@_FIND_COMPONENTS})
    if(NOT ${component} IN_LIST _@PROJECT_NAME@_supported_components)
        set(@PROJECT_NAME@_FOUND False)
        set(@PROJECT_NAME@_NOT_FOUND_MESSAGE "Unsupported component: ${component}")
    else()
        include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-${component}-dependencies.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-${component}-targets.cmake")
        set(@PROJECT_NAME@_${component}_FOUND True)
    endif()
endforeach()
  